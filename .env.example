# NCBI Entrez (PubMed ingestion) — required by NCBI etiquette
ENTREZ_EMAIL=you@example.com
# Optional: raises rate limit 3 -> 10 req/s. Leave blank if you don't have one.
ENTREZ_API_KEY=

# Database (matches docker-compose credentials)
DATABASE_URL=postgresql://neurorag:neurorag@localhost:5432/neurorag

# Embedding model (Hugging Face ID, 768-dim)
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# LLM provider for the answer step — fill in when you reach the LLM phase
LLM_PROVIDER=
LLM_API_KEY=